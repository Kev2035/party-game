# Copia questo file come ".env.local" (resta solo sul tuo PC) e incolla i valori
# dalla console di Firebase → Impostazioni progetto → Le tue app → Configurazione SDK.
# Guida completa: docs/ONLINE.md

VITE_BACKEND=firebase

VITE_FIREBASE_API_KEY=incolla-qui-apiKey
VITE_FIREBASE_AUTH_DOMAIN=nome-progetto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://nome-progetto-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=nome-progetto
VITE_FIREBASE_APP_ID=incolla-qui-appId

# Per tornare al backend finto (test in un solo browser) basta mettere:
# VITE_BACKEND=mock
